# Copie para .env (ou defina como variáveis de ambiente). NUNCA versione o .env com chave real.

# hibrido (padrão: modelo pensante; regras de palavras-chave como plano B) | llm | regras (sem modelo, sem internet)
URGENCIA_MODO=hibrido
URGENCIA_LIMIAR_CONFIANCA=0.6

# Modelo (qualquer API compatível com OpenAI). Padrão: Ollama local (`ollama pull qwen2.5:7b`).
URGENCIA_LLM_URL=http://localhost:11434/v1
URGENCIA_LLM_MODELO=qwen2.5:7b
# Groq:   URGENCIA_LLM_URL=https://api.groq.com/openai/v1
# Gemini: URGENCIA_LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai
URGENCIA_LLM_API_KEY=
URGENCIA_LLM_TIMEOUT_S=20
URGENCIA_LLM_TENTATIVAS=2
URGENCIA_LLM_MAX_TOKENS=800
# Só para modelos de raciocínio (ex.: gpt-oss): low | medium | high. Aumente MAX_TOKENS junto.
URGENCIA_LLM_REASONING_EFFORT=
URGENCIA_LLM_SEED=
URGENCIA_LLM_JSON_MODE=true

# Proteção de hardware/custo
URGENCIA_VAZAO_POR_MINUTO=30
URGENCIA_MAX_CONCORRENCIA=1
# Piso de segurança das regras no modo hibrido (não desligue sem motivo)
URGENCIA_PISO_REGRAS=true

# Servidor do agente. Se AGENTE_TOKEN for definido, o Spring deve enviar o mesmo valor em URGENCIA_AGENTE_TOKEN.
HOST=127.0.0.1
PORT=8000
AGENTE_TOKEN=
